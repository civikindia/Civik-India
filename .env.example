# CivikIndia environment template
# Copy to .env for local development. In Koyeb/Render, create these as dashboard environment variables.
# Never commit real secrets.

# Application
FLASK_ENV=development
SECRET_KEY=replace-with-random-secret
PORT=8000
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=120
TRUST_PROXY_HEADERS=false

# Database
DATABASE_URL=
DEV_DATABASE_URL=sqlite:///instance/civikindia_dev.db
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=2
SQLALCHEMY_POOL_RECYCLE=1800

# Upload security
MAX_UPLOAD_MB=16
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,webp,pdf,mp4,mov,mp3,wav,txt,doc,docx
UPLOAD_FOLDER=uploads
EVIDENCE_ENCRYPTION_KEY=replace-with-32-byte-hex-or-long-random-string
AUDIT_HMAC_SECRET=replace-with-long-random-secret
CLAMAV_ENABLED=false
CLAMAV_SCANNER_PATH=clamscan

# Cloudflare R2 private evidence storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# Optional. Do not use public evidence links by default.
R2_PUBLIC_BASE_URL=

# Google Drive private backup/archive storage
GOOGLE_DRIVE_BACKUP_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
BACKUP_CRON_TOKEN=

# Redis / Celery (optional)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Email notifications (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_SUPPRESS_SEND=false
NOTIFICATION_TO_EMAIL=

# AI assistant (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For OpenAI-compatible providers such as Mistral:
# OPENAI_BASE_URL=https://api.mistral.ai/v1
# OPENAI_MODEL=mistral-medium-latest

# Staff bootstrap credentials. Required in production; use strong unique values.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-with-strong-admin-password
DEFAULT_ADMIN_EMAIL=admin@civikindia.gov.in
DEFAULT_OFFICER_USERNAME=officer_water
DEFAULT_OFFICER_PASSWORD=replace-with-strong-officer-password
DEFAULT_OFFICER_EMAIL=officer_water@civikindia.gov.in
DEFAULT_OFFICER_DEPARTMENT=Water Supply
SEED_ADMIN_PASSWORD=
SEED_OFFICER_PASSWORD=

# Runtime and rate limiting
SESSION_LIFETIME_HOURS=8
PUBLIC_API_CACHE_SECONDS=15
SLA_CHECK_INTERVAL_SECONDS=20
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_WINDOW_SECONDS=300
LOGIN_RATE_MAX_ATTEMPTS_PER_IP=25
LOGIN_RATE_MIN_INTERVAL_SECONDS=1
SUBMIT_RATE_LIMIT_ENABLED=true
SUBMIT_RATE_WINDOW_SECONDS=300
SUBMIT_RATE_MAX_ATTEMPTS_PER_IP=20
AI_RATE_MIN_INTERVAL_SECONDS=3
AI_RATE_WINDOW_SECONDS=60
AI_RATE_MAX_REQUESTS_PER_WINDOW=20
GEO_HEATMAP_MAX_POINTS=2500

# 2FA
ADMIN_EMAIL_2FA_ENABLED=false
ADMIN_OTP_EXPIRY_MINUTES=5
ADMIN_OTP_LENGTH=6

# SMS / WhatsApp notifications (optional)
SMS_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_NOTIFICATION_TO=
WHATSAPP_ENABLED=false
